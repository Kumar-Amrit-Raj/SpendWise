{
    "name":  "spendwise",
    "version":  "2.0.0",
    "private":  true,
    "description":  "Full-stack personal finance dashboard for transactions, budgets, recurring entries, reports and investment planning",
    "main":  "backend/server.js",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "start":  "node backend/server.js",
                    "dev":  "concurrently \"npm run backend\" \"npm run frontend\"",
                    "build":  "npm run build --prefix frontend",
                    "postinstall":  "npm install --prefix frontend",
                    "backend":  "node --watch backend/server.js",
                    "frontend":  "npm start --prefix frontend",
                    "frontend-install":  "npm install --prefix frontend"
                },
    "dependencies":  {
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.21.0",
                         "jsonwebtoken":  "^9.0.2",
                         "mongoose":  "^8.7.0"
                     },
    "devDependencies":  {
                            "concurrently":  "^9.0.0"
                        }
}
